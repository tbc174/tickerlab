TICKERLAB_DATABASE_URL=postgresql://tickerlab:TROQUE_A_SENHA@postgres:5432/tickerlab

# No servidor de produção: "producao". Assim, sem o [auth] do secrets.toml o app NÃO abre
# (sem a variável, ele cairia no modo local, sem contas e com tudo liberado)
TICKERLAB_AMBIENTE=producao

# E-mails (separados por vírgula) que viram administradores no primeiro login
TICKERLAB_ADMINS=

# --- Stripe (SOMENTE modo de teste; veja projeto-acoes/stripe.md) ---
# Chave restrita de teste (rk_test_...) ou secreta de teste (sk_test_...): chaves de produção são recusadas
STRIPE_SECRET_KEY=
# Segredo do webhook (whsec_...), mostrado ao criar o endpoint no painel do Stripe
STRIPE_WEBHOOK_SECRET=
# Preço do plano Pro (price_...), criado no painel do Stripe
STRIPE_PRICE_ID=
# Endereço público do app, sem barra no final (para onde o Stripe devolve a pessoa)
TICKERLAB_URL_PUBLICA=https://app.tickerlab.com.br

# --- Newsletter por e-mail (Research, etapa 5c; decisão 0020) ---
# Chave da API do Resend (re_...). Sem ela, nada é enviado: a edição é montada e fica "retida".
# Coloque no servidor por script que pede no terminal, nunca pelo chat.
RESEND_API_KEY=
# Remetente (o domínio precisa estar verificado no Resend, com SPF e DKIM na Cloudflare)
TICKERLAB_NEWSLETTER_REMETENTE=TickerLab <newsletter@tickerlab.com.br>
# Endereço público da API, sem barra no final (o link "sair da Newsletter" de cada e-mail)
TICKERLAB_URL_DA_API=https://api.tickerlab.com.br

# --- Preço do Yahoo no relatório da empresa (D3 mudada em 20/10/2026) ---
# 0 tira, sem deploy, o preço do Yahoo da ficha da empresa (tela, PDF e API): somem o dividend
# yield, o valor de mercado e os múltiplos (P/L, P/VP, EV/EBITDA...). Sem a variável, fica ligado.
TICKERLAB_PRECO_NO_RELATORIO=1

# --- Sala de dados (B-20; arquivos cifrados das operações) ---
# A chave-mestra NÃO vai neste .env: fica em .env.sala, lido só pela API (compose.yaml). Formato
# v1:<base64 de 32 bytes>; gerada no servidor pelo projeto-acoes/configurar-chave-da-sala.ps1,
# nunca pelo chat. Para trocar sem recifrar, a nova vem na frente: v2:...,v1:...
# TICKERLAB_CHAVE_DA_SALA=
# Pasta dos arquivos cifrados (no contêiner, /app/dados_sala; sem a variável, dados_sala)
# TICKERLAB_PASTA_DA_SALA=

# --- Opcionais (sem a variável vale o padrão do código; lista conferida em 05/11/2026) ---
# 1 liga as rotas de leitura da API (v1, ADR 0048) e as da API externa (src/api.py)
# TICKERLAB_API_V1=
# TICKERLAB_API_EXTERNA=
# client_id do login do Google (o mesmo do [auth] do secrets.toml): a API valida o token com ele
# TICKERLAB_GOOGLE_CLIENT_ID=
# Logs (src/logs.py): "json" em produção (uma linha de JSON por registro) e o nível (INFO, DEBUG...)
# TICKERLAB_LOG_FORMATO=json
# TICKERLAB_LOG_NIVEL=INFO
# Proxies confiáveis (IPs ou redes, separados por vírgula): só vindo deles o cabeçalho da Cloudflare
# vale como o IP de quem pede (limites por IP e registro de acesso); e o arquivo desse registro
# TICKERLAB_PROXIES_CONFIAVEIS=
# TICKERLAB_REGISTRO_DE_ACESSO=
# E-mail de contato que fontes como a SEC exigem em cada consulta
# TICKERLAB_CONTATO=
# Remetentes dos outros e-mails (domínio verificado no Resend) e o destinatário único do boletim
# diário da base (vazio = o envio é recusado)
# TICKERLAB_ENTRADA_REMETENTE=TickerLab <entrada@tickerlab.com.br>
# TICKERLAB_NOVIDADES_REMETENTE=TickerLab <novidades@tickerlab.com.br>
# TICKERLAB_BOLETIM_REMETENTE=TickerLab <boletim@tickerlab.com.br>
# TICKERLAB_BOLETIM_PARA=
# Trava da Newsletter (ligada por padrão): 0 libera o envio a quem não é administrador (ADR 0020)
# TICKERLAB_NEWSLETTER_SO_ADMINS=
# 0 tira o Ibovespa e o bitcoin das ferramentas do site (ADR 0070)
# TICKERLAB_PONTE_COM_YAHOO=
# Endereço do JSON de dados das ferramentas do site
# TICKERLAB_DADOS_DAS_FERRAMENTAS=https://tickerlab.com.br/dados/ferramentas.json
# Pastas e arquivos de dados (padrão dentro de dados_locais/): acervo ("desligado" para de guardar),
# cadastro da Receita, dossiês, análises escritas, pregão, preços (SQLite), mapa e painel do café
# TICKERLAB_ACERVO=
# TICKERLAB_CNPJ=
# TICKERLAB_DOSSIES=
# TICKERLAB_ANALISES=
# TICKERLAB_PREGAO=
# TICKERLAB_BANCO=
# TICKERLAB_MAPA_DO_CAFE=
# TICKERLAB_PAINEL_DO_CAFE=
# Arquivo da chave dos pseudônimos de pessoas (ADR 0106; padrão /etc/tickerlab/pessoas.chave; a
# chave nunca vai ao Git)
# TICKERLAB_PESSOAS_CHAVE=
# Commit em execução: o build grava (Dockerfile, compose.yaml); não defina à mão
# TICKERLAB_VERSAO=
