TICKERLAB_DATABASE_URL=postgresql://tickerlab:TROQUE_A_SENHA@postgres:5432/tickerlab

# No servidor de produção: "producao". Assim, sem o [auth] do secrets.toml o app NÃO abre
# (sem a variável, ele cairia no modo local, sem contas e com tudo liberado)
TICKERLAB_AMBIENTE=producao

# E-mails (separados por vírgula) que viram administradores no primeiro login
TICKERLAB_ADMINS=

# --- Stripe (SOMENTE modo de teste; veja projeto-acoes/stripe.md) ---
# Chave restrita de teste (rk_test_...) ou secreta de teste (sk_test_...): chaves de produção são recusadas
STRIPE_SECRET_KEY=
# Segredo do webhook (whsec_...), mostrado ao criar o endpoint no painel do Stripe
STRIPE_WEBHOOK_SECRET=
# Preço do plano Pro (price_...), criado no painel do Stripe
STRIPE_PRICE_ID=
# Endereço público do app, sem barra no final (para onde o Stripe devolve a pessoa)
TICKERLAB_URL_PUBLICA=https://servidor.taila57363.ts.net:8443

# --- Newsletter por e-mail (Research, etapa 5c; decisão 0020) ---
# Chave da API do Resend (re_...). Sem ela, nada é enviado: a edição é montada e fica "retida".
# Coloque no servidor por script que pede no terminal, nunca pelo chat.
RESEND_API_KEY=
# Remetente (o domínio precisa estar verificado no Resend, com SPF e DKIM na Cloudflare)
TICKERLAB_NEWSLETTER_REMETENTE=TickerLab <newsletter@tickerlab.com.br>
# Endereço público da API, sem barra no final (o link "sair da Newsletter" de cada e-mail)
TICKERLAB_URL_DA_API=https://api.tickerlab.com.br

# --- Preço do Yahoo no relatório da empresa (D3 mudada em 20/10/2026) ---
# 0 tira, sem deploy, o preço do Yahoo da ficha da empresa (tela, PDF e API): somem o dividend
# yield, o valor de mercado e os múltiplos (P/L, P/VP, EV/EBITDA...). Sem a variável, fica ligado.
TICKERLAB_PRECO_NO_RELATORIO=1
