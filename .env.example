TICKERLAB_DATABASE_URL=postgresql://tickerlab:TROQUE_A_SENHA@postgres:5432/tickerlab

# E-mails (separados por vírgula) que viram administradores no primeiro login
TICKERLAB_ADMINS=

# --- Stripe (SOMENTE modo de teste; veja projeto-acoes/stripe.md) ---
# Chave restrita de teste (rk_test_...) ou secreta de teste (sk_test_...): chaves de produção são recusadas
STRIPE_SECRET_KEY=
# Segredo do webhook (whsec_...), mostrado ao criar o endpoint no painel do Stripe
STRIPE_WEBHOOK_SECRET=
# Preço do plano Pro (price_...), criado no painel do Stripe
STRIPE_PRICE_ID=
# Endereço público do app, sem barra no final (para onde o Stripe devolve a pessoa)
TICKERLAB_URL_PUBLICA=https://servidor.taila57363.ts.net:8443
