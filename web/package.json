{
  "name": "tickerlab-web",
  "private": true,
  "version": "0.0.0",
  "description": "Front-end do TickerLab em React (ADR 0048): o site público e, depois, o app.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --ssr src/entry-server.tsx --outDir dist-servidor && node scripts/prerender.mjs",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "licencas": "node scripts/licencas.mjs",
    "site": "npm run ferramentas && vite build --ssr src/entry-server.tsx --outDir dist-servidor && node scripts/prerender.mjs ../site",
    "ferramentas": "vite build --config vite.ferramentas.config.ts",
    "app": "vite build --config vite.app.config.ts",
    "app:dev": "vite --config vite.app.config.ts"
  },
  "dependencies": {
    "preact": "10.29.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
