{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "ctrl+k f": "command:fechar-tarefa",
        "ctrl+k p": "command:publicar",
        "ctrl+k o": "command:o-que-aconteceu",
        "ctrl+k a": "command:arrumar-fila",
        "ctrl+k n": "command:abrir-conversa"
      }
    }
  ]
}
